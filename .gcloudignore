# Cloud Run deployment should only include specs-platform/ directory
# Everything else is excluded to minimize deployment size

# Exclude everything by default
*

# But include specs-platform directory and config
!specs-platform/
!Procfile

# Also allow .gcloudignore itself
!.gcloudignore

# Within specs-platform, exclude build artifacts
specs-platform/__pycache__/
specs-platform/*.pyc
specs-platform/*.bak
specs-platform/.DS_Store

# Exclude git artifacts (these slow down build)
.git/
.gitignore
.gitattributes

# Exclude docs directory (specs are fetched from GitHub, not copied)
docs/
.github/
mobius-*/

# Exclude config files not needed by Cloud Run
.claude/
Dockerfile
cloudbuild.yaml
